{
  "name": "crosssafe",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:e2e": "python3 tests/e2e.py",
    "test:ci": "node --test --test-reporter=tap --test-reporter-destination=stdout --test-reporter=./tests/_ran-files-reporter.mjs --test-reporter-destination=${RAN_FILES:-/tmp/ran-files.txt} tests/*.test.js",
    "test:final": "NPM_TEST_FINAL=1 node --test --test-reporter=tap --test-reporter-destination=stdout --test-reporter=./tests/_ran-files-reporter.mjs --test-reporter-destination=${RAN_FILES:-/tmp/ran-files.txt} tests/*.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "axe-core": "^4.14.0",
    "jsdom": "^24.1.3"
  }
}
